// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Author {
  id Int @id @default(autoincrement())

  penName String @unique @map("pen_name") @db.VarChar(150)

  realName String? @map("real_name") @db.VarChar(150)

  bio String? @db.Text

  // Life dates & Origins
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  dateOfDeath DateTime? @map("date_of_death") @db.Date
  birthPlace  String?   @map("birth_place") @db.VarChar(150)

  isAnonymous Boolean @default(false) @map("is_anonymous")

  createdAt DateTime @default(now()) @map("created_at")

  books         Book[]
  literaryTalks LiteraryTalk[]

  @@map("authors")
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(200)
  authorId      Int      @map("author_id")
  author        Author   @relation(fields: [authorId], references: [id])
  isbn          String?  @unique @db.VarChar(20)
  price         Decimal? @db.Decimal(10, 2)
  genre         String?  @db.VarChar(50)
  stockQuantity Int      @default(0) @map("stock_quantity")
  publishedYear Int?     @map("published_year")

  // Media / Digital Assets
  youtubeUrl String? @map("youtube_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@index([authorId])
  @@map("books")
}

model LiteraryTalk {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  description String?  @db.Text
  youtubeUrl  String   @map("youtube_url") @db.VarChar(500)
  eventDate   DateTime @map("date")
  location    String?  @db.VarChar(100)

  // Relations
  authorId Int    @map("author_id")
  author   Author @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([authorId])
  @@map("literary_talks")
}

model Order {
  id           Int      @id @default(autoincrement())
  bookId       Int      @map("book_id")
  customerName String   @map("customer_name") @db.VarChar(100)
  quantity     Int
  orderDate    DateTime @default(now()) @map("order_date")
  status       String?  @db.VarChar(20)
  book         Book     @relation(fields: [bookId], references: [id])

  @@map("orders")
}
